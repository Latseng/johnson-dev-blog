---
import PostComments from "@components/PostComments.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import TableOfContents from "@components/TableOfContents.astro";
import { Icon } from "astro-icon/components";
import { CldImage } from "astro-cloudinary";
import { formatDate } from "@utils/format-utils";

const { frontmatter, readingTime, headings } = Astro.props;
const slug = Astro.params.slug;

if (!slug) {
  return Astro.redirect("/404");
}
---

<BaseLayout pageTitle={frontmatter.title}>
  <article class="prose sm:prose-lg dark:prose-invert mt-24 mx-auto p-4">
    <h1>{frontmatter.title}</h1>
    <p><em>{frontmatter.description}</em></p>
    <div class="flex items-center gap-2 text-sm">
      <Icon name="material-symbols:calendar-today-outline-rounded" class="size-5" />
      <span class="text-gray-400">
        {formatDate(frontmatter.pubDate)}
      </span>
      <span class="mx-2">|</span>
      <Icon name="material-symbols:person-outline-rounded" class="size-4" />
      <span>
        <a href="/about" class="no-underline hover:underline"
          >{frontmatter.author}</a
        >
      </span>
      <span class="mx-1">|</span>
      <span>閱讀時間：{readingTime}</span>
    </div>
    <CldImage
      src={frontmatter.image.url}
      alt={frontmatter.image.alt}
      width={800}
      height={450}
      crop={{
        type: "fit",
        source: true,
      }}
      format="auto"
      quality="auto"
    />
    <div class="flex flex-wrap">
      {
        frontmatter.tags.map((tag: string) => (
          <p class="flex items-center p-2 text-sm bg-slate-50 dark:bg-slate-800 border border-gray-300 dark:border-gray-600 rounded-md mx-2">
            <Icon name="material-symbols:tag-rounded" class="size-4 mr-2 text-sky-600" />
            <a class="text-sky-600" href={`/tags/${tag}`}>
              {tag}
            </a>
          </p>
        ))
      }
    </div>
    <TableOfContents headings={headings} />
    <div>
      <slot />
    </div>
    <PostComments />
  </article>
</BaseLayout>

<script>
  const target = document.getElementById("dynamic-toc");

  if (target) {
    window.addEventListener("scroll", () => {
      if (window.scrollY > 1000) {
        target.classList.remove("hidden");
      } else {
        target.classList.add("hidden");
      }
    });
  }
</script>
