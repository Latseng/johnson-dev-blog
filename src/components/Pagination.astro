---
interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;
const indexPageLink = currentPage === 2;
const hasPrevPage = currentPage > 1;
const hasNextPage = totalPages > currentPage;
const pageList = Array.from({ length: totalPages }, (_, i) => i + 1);

const btnClass =
  "border border-primary hover:bg-slate-300 dark:hover:bg-slate-700 rounded-md h-10 w-10 font-semibold flex items-center justify-center transition duration-200";
const disabledClass =
  "border border-gray-400 opacity-40 rounded-md h-10 w-10 font-semibold flex items-center justify-center pointer-events-none";
const activeClass =
  "border text-white bg-gray-500 border-primary rounded-md h-10 w-10 leading-[35px] font-semibold";
---

{
  totalPages > 1 && (
    <nav
      class="my-16 flex justify-center space-x-2 text-center"
      aria-label="Pagination"
    >
      {/* previous */}
      {hasPrevPage ? (
        <a
          href={indexPageLink ? "/" : `/page/${currentPage - 1}`}
          class={btnClass}
        >
          <span class="sr-only">Previous</span>
          <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        </a>
      ) : (
        <span class={disabledClass}>
          <span class="sr-only">Previous</span>
          <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        </span>
      )}

      {/* page index */}
      {pageList.map((page, i) =>
        page === currentPage ? (
          <span aria-current="page" class={activeClass}>
            {page}
          </span>
        ) : (
          <a
            href={i === 0 ? "/" : `/page/${page}`}
            class={btnClass}
          >
            {page}
          </a>
        )
      )}

      {/* next page */}
      {hasNextPage ? (
        <a href={`/page/${currentPage + 1}`} class={btnClass}>
          <span class="sr-only">Next</span>
          <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
        </a>
      ) : (
        <span class={disabledClass}>
          <span class="sr-only">Next</span>
          <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
        </span>
      )}
    </nav>
  )
}
